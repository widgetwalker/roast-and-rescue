{
  "name": "roast-and-rescue",
  "version": "1.0.0",
  "description": "GitHub Roast & Rescue - Brutally honest developer feedback with actionable improvement advice",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx test.ts",
    "test:a11y": "tsx test.ts --a11y",
    "test:unit": "tsx test.ts --unit",
    "test:analyzer": "tsx test.ts --analyzer",
    "test:api": "tsx test.ts --api"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

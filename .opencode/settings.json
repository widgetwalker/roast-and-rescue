{
  "permissionAllowlist": [
    "curl",
    "bash",
    "read",
    "python",
    "git"
  ],
  "envVars": {
    "GITHUB_TOKEN": "",
    "ANTHROPIC_API_KEY": ""
  },
  "allowedPermissions": [
    "github:api:read",
    "fs:read",
    "term:read",
    "http:request"
  ],
  "settings": {
    "reducePermissionPrompts": true,
    "cacheApiResponses": true,
    "respectRateLimits": true
  }
}